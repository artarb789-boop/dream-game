config_version=5

[application]
config/name="Первое убежище"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4","GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=760
window/size/window_width_override=1080
window/size/window_height_override=684
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055,0.086,0.09,1)
